{
  "runtime": "onnxruntime-android",
  "model_asset": "pano_model.onnx",
  "input_images": [1, 6, 3, 224, 224],
  "input_rotations": [1, 6, 3, 3],
  "pose_representation": "camera-to-world rotation matrices derived from yaw_pitch_roll_degrees",
  "input_normalization": {"scale": "1/255", "mean": [0.0, 0.0, 0.0], "std": [1.0, 1.0, 1.0]},
  "letterbox": {"width": 224, "height": 224, "interpolation": "bilinear", "padding": "zero"},
  "frame_padding": "repeat_last_valid_frame_and_pose",
  "output_panorama": [1, 3, 256, 512],
  "output_range": "0..1 RGB",
  "fisheye_model": "180_degree_equidistant"
}
